# Google Cloud & Vertex AI Configuration (Preferred for Cloud Shell / Cloud Run)
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-04-ef48e08bc216
GOOGLE_CLOUD_LOCATION=global

# Optional: Gemini API Key if running outside Vertex AI
# GOOGLE_API_KEY=your-gemini-api-key

# Challenge 2 — Food Equity & Surplus Broker Settings
FOOD_RESCUE_METRO=Atlanta
BIGQUERY_DATASET=a4i_food
BQ_DATASET=a4i_food
BIGQUERY_LOCATION=US
BQ_LOCATION=US
EMBED_ENDPOINT=gemini-embedding-2
GEMINI_MODEL=gemini-3.8-flash

# Managed MCP Server / MCP Toolbox Configuration (Consumed by agent/mcp_config.py)
# Set MCP_TOOLBOX_URL when running MCP Toolbox on Cloud Run or locally
MCP_TOOLBOX_URL=
ENABLE_MANAGED_BQ_MCP=true
